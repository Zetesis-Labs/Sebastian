# syntax=docker/dockerfile:1.7

ARG GO_VERSION=1.26.5
ARG DEBIAN=bookworm
# Classic AirPlay: no NQPTP, so one node can hold a receiver per speaker.
ARG SHAIRPORT_VERSION=5.6.2

FROM debian:${DEBIAN}-slim AS receiver
RUN apt-get update && apt-get install -y --no-install-recommends \
      autoconf automake build-essential ca-certificates git libtool pkg-config \
      libavcodec-dev libavformat-dev libavutil-dev libconfig-dev libpopt-dev libssl-dev libswresample-dev
ARG SHAIRPORT_VERSION
RUN git clone --depth 1 --branch "${SHAIRPORT_VERSION}" https://github.com/mikebrady/shairport-sync /src \
    && cd /src \
    && autoreconf -fi \
    && ./configure --sysconfdir=/etc --with-stdout --with-tinysvcmdns --with-ssl=openssl \
    && make -j"$(nproc)" \
    && install -m 0755 shairport-sync /out-shairport-sync

FROM golang:${GO_VERSION}-${DEBIAN} AS builder
RUN apt-get update && apt-get install -y --no-install-recommends libopus-dev libopusfile-dev pkg-config
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -ldflags="-s -w" -o /out/airplay-bridge ./cmd/airplay-bridge

FROM debian:${DEBIAN}-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates libavcodec59 libavformat59 libavutil57 libconfig9 libopus0 libopusfile0 libpopt0 libssl3 libswresample4 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=receiver /out-shairport-sync /usr/local/bin/shairport-sync
COPY --from=builder /out/airplay-bridge /usr/local/bin/airplay-bridge
USER 1001:1001
ENTRYPOINT ["/usr/local/bin/airplay-bridge"]
