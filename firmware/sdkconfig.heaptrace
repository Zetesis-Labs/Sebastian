# Diagnostic overlay, never for production: heap tracing of each session
# (main/heap_diag.c). Build with `make fw-build-heaptrace`.
CONFIG_HEAP_TRACING_STANDALONE=y
CONFIG_HEAP_TRACING_STACK_DEPTH=12
CONFIG_HEAP_TRACE_HASH_MAP=y
CONFIG_HEAP_TRACE_HASH_MAP_IN_EXT_RAM=y
CONFIG_HEAP_TRACE_HASH_MAP_SIZE=512
